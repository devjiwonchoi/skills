#!/bin/sh
# Usage: criteria-hash <ALIGN.md>
# Print the sha256 hex digest of the ALIGN.md end state and criteria.
# Align and Verify run this script. Nothing else defines the hash.
#
# When a "# Criteria" heading is present outside a fence, hash the
# "# End state" body and the "# Criteria" body, in file order. The align
# template puts the "## E2E workflow" diagram in the end state body, so
# that diagram is part of the hash. Each body
# runs from the line after its heading until the next "^# " line outside
# a fence. Both sections must contain a non-blank line.
# A fence opens on three or more ` or ~ and closes only on at least that
# many of the same character, so ``` inside a ```` fence does not end it.
# A fenced heading does not start or end a section.
# Otherwise, unchanged: lines after "# Success criteria" until a "^# "
# line outside a fence. When that section is absent, lines matching
# "^- Done when:", in file order.
# Strip trailing whitespace on each line. Drop "---" lines and trailing
# blank lines. Join with newlines and one final newline. Exit 1 when the
# hashed text has no non-blank lines, or when neither form is present.

set -eu

if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
  echo "usage: criteria-hash <ALIGN.md>" >&2
  exit 1
fi

tmp=$(mktemp "${TMPDIR:-/tmp}/criteria-hash.XXXXXX")
trap 'rm -f "$tmp"' EXIT

if ! awk '
function strip(s) {
  sub(/\r$/, "", s)
  sub(/[[:space:]]+$/, "", s)
  return s
}

function parse_fence(s,    rest, ch, n) {
  rest = s
  sub(/^[[:space:]]*/, "", rest)
  ch = substr(rest, 1, 1)
  if (ch != "`" && ch != "~") {
    return 0
  }
  n = 0
  while (substr(rest, n + 1, 1) == ch) {
    n++
  }
  if (n < 3) {
    return 0
  }
  mark_ch = ch
  mark_n = n
  mark_rest = substr(rest, n + 1)
  return 1
}

function section_blank(s, e,    i, any) {
  any = 0
  for (i = s; i < e; i++) {
    if (all[i] ~ /^[[:space:]]*---[[:space:]]*$/) {
      continue
    }
    if (all[i] !~ /^[[:space:]]*$/) {
      any = 1
    }
  }
  return !any
}

function take_section(s, e,    i) {
  for (i = s; i < e; i++) {
    buf[++n] = all[i]
  }
}

function emit(n,    i, m, any) {
  m = 0
  any = 0
  for (i = 1; i <= n; i++) {
    if (buf[i] ~ /^[[:space:]]*---[[:space:]]*$/) {
      continue
    }
    if (buf[i] !~ /^[[:space:]]*$/) {
      any = 1
    }
    m++
    kept[m] = buf[i]
  }
  while (m > 0 && kept[m] ~ /^[[:space:]]*$/) {
    m--
  }
  if (!any || m == 0) {
    return 1
  }
  for (i = 1; i <= m; i++) {
    print kept[i]
  }
  return 0
}

{
  all[++na] = strip($0)
}

END {
  fence_ch = ""
  fence_len = 0
  mode = ""
  es_s = 0
  es_e = 0
  cr_s = 0
  cr_e = 0
  for (i = 1; i <= na; i++) {
    if (fence_len > 0) {
      if (parse_fence(all[i]) && mark_ch == fence_ch && mark_n >= fence_len && mark_rest ~ /^[[:space:]]*$/) {
        fence_ch = ""
        fence_len = 0
      }
      continue
    }
    if (parse_fence(all[i]) && (mark_ch != "`" || index(mark_rest, "`") == 0)) {
      fence_ch = mark_ch
      fence_len = mark_n
      continue
    }
    if (all[i] ~ /^# /) {
      if (mode == "end" && es_e == 0) {
        es_e = i
      }
      if (mode == "criteria" && cr_e == 0) {
        cr_e = i
      }
      mode = ""
      if (all[i] ~ /^# End state[[:space:]]*$/ && es_s == 0) {
        mode = "end"
        es_s = i + 1
      } else if (all[i] ~ /^# Criteria[[:space:]]*$/ && cr_s == 0) {
        mode = "criteria"
        cr_s = i + 1
      }
    }
  }
  if (mode == "end" && es_e == 0) {
    es_e = na + 1
  }
  if (mode == "criteria" && cr_e == 0) {
    cr_e = na + 1
  }
  if (cr_s > 0) {
    if (es_s == 0) {
      print "criteria-hash: # Criteria requires a # End state section" > "/dev/stderr"
      exit 1
    }
    if (es_e == 0) {
      es_e = na + 1
    }
    if (cr_e == 0) {
      cr_e = na + 1
    }
    if (section_blank(es_s, es_e) || section_blank(cr_s, cr_e)) {
      print "criteria-hash: end state and criteria sections need non-blank lines" > "/dev/stderr"
      exit 1
    }
    n = 0
    if (es_s < cr_s) {
      take_section(es_s, es_e)
      take_section(cr_s, cr_e)
    } else {
      take_section(cr_s, cr_e)
      take_section(es_s, es_e)
    }
    if (emit(n) != 0) {
      print "criteria-hash: end state and criteria sections need non-blank lines" > "/dev/stderr"
      exit 1
    }
    exit 0
  }

  fence_ch = ""
  fence_len = 0
  start = 0
  end = 0
  for (i = 1; i <= na; i++) {
    if (fence_len > 0) {
      if (parse_fence(all[i]) && mark_ch == fence_ch && mark_n >= fence_len && mark_rest ~ /^[[:space:]]*$/) {
        fence_ch = ""
        fence_len = 0
      }
      continue
    }
    if (parse_fence(all[i]) && (mark_ch != "`" || index(mark_rest, "`") == 0)) {
      fence_ch = mark_ch
      fence_len = mark_n
      continue
    }
    if (start == 0) {
      if (all[i] ~ /^# Success criteria[[:space:]]*$/) {
        start = i + 1
      }
      continue
    }
    if (all[i] ~ /^# /) {
      end = i
      break
    }
  }
  if (start > 0) {
    if (end == 0) {
      end = na + 1
    }
    n = 0
    for (i = start; i < end; i++) {
      buf[++n] = all[i]
    }
    if (emit(n) != 0) {
      print "criteria-hash: success criteria section has no non-blank lines" > "/dev/stderr"
      exit 1
    }
    exit 0
  }
  n = 0
  for (i = 1; i <= na; i++) {
    if (all[i] ~ /^- Done when:/) {
      buf[++n] = all[i]
    }
  }
  if (n == 0 || emit(n) != 0) {
    print "criteria-hash: no success criteria section or Done when lines" > "/dev/stderr"
    exit 1
  }
  exit 0
}
' "$1" > "$tmp"; then
  exit 1
fi

if command -v sha256sum >/dev/null 2>&1; then
  digest=$(sha256sum "$tmp")
elif command -v shasum >/dev/null 2>&1; then
  digest=$(shasum -a 256 "$tmp")
else
  echo "criteria-hash: need sha256sum or shasum" >&2
  exit 1
fi

printf '%s\n' "$digest" | awk 'NR == 1 { print $1; exit }'
