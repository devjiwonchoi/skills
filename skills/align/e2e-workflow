#!/bin/sh
# The one E2E workflow diagram in ALIGN.md.
#
# Usage:
#   e2e-workflow check <ALIGN.md>
#   e2e-workflow diff <ALIGN.md> <ALIGN.approved.md>
#
# check validates the diagram, E2E proofs, and file proofs.
# On success it prints each node in diagram order:
#   <id><TAB><spec-or-><TAB><label>
# A node outside a Playwright journey uses "-" as the spec.
# diff prints "match" or "drift" for the diagram fence.
# Exit 1 when the file is invalid or the diagram drifted.
#
# The diagram is the last part of "# End state", so criteria-hash covers it.
# Heading line: "## E2E workflow"
# The next non-blank line is a fence ```mermaid whose first line is
# "flowchart LR". That fence is the only mermaid diagram in the file.
# One subgraph per Playwright journey:
#   subgraph <basename> ["<basename>"]
# <basename> matches ^[a-z0-9]+(-[a-z0-9]+)*\.spec\.ts$
# A node is <id>["<label>"] joined by " --> ".
# <id> matches ^[a-z0-9]+(-[a-z0-9]+)*$ and is unique in the diagram.
# Each journey has at most 7 nodes. The same cap applies to nodes
# that sit outside a journey.
# A proof line "- Proof: E2E: <id>" names a node inside a journey.
# A proof line "- Proof: file `<path>`" names a path in "# Files".
# A files bullet is "- `<path>` · NEW | MODIFIED | DELETED · <why>".

set -eu

if [ "$#" -lt 1 ]; then
  echo "usage: e2e-workflow check <ALIGN.md> | diff <ALIGN.md> <ALIGN.approved.md>" >&2
  exit 1
fi

mode=$1
shift

awk_prog='
function strip(s) {
  sub(/\r$/, "", s)
  sub(/[[:space:]]+$/, "", s)
  return s
}

function ltrim(s) {
  sub(/^[[:space:]]+/, "", s)
  return s
}

function die(msg) {
  print "e2e-workflow: " msg > "/dev/stderr"
  exit 1
}

function parse_fence(s,    rest, ch, n) {
  rest = s
  sub(/^[[:space:]]*/, "", rest)
  ch = substr(rest, 1, 1)
  if (ch != "`" && ch != "~") {
    return 0
  }
  n = 0
  while (substr(rest, n + 1, 1) == ch) {
    n++
  }
  if (n < 3) {
    return 0
  }
  mark_ch = ch
  mark_n = n
  mark_rest = substr(rest, n + 1)
  return 1
}

function is_node_id(id) {
  return id ~ /^[a-z0-9]+(-[a-z0-9]+)*$/ && id != "end" && id != "subgraph" && id != "flowchart" && id != "graph"
}

function is_spec(name) {
  return name ~ /^[a-z0-9]+(-[a-z0-9]+)*\.spec\.ts$/
}

function bad_label(label) {
  return label == "" || index(label, "\"") > 0 || index(label, "]") > 0 || index(label, "`") > 0 || index(label, " --> ") > 0
}

function parse_node(token,    p, id, label) {
  p = index(token, "[\"")
  if (p < 2) {
    return 0
  }
  id = substr(token, 1, p - 1)
  label = substr(token, p + 2)
  if (length(label) < 2 || substr(label, length(label) - 1) != "\"]") {
    return 0
  }
  label = substr(label, 1, length(label) - 2)
  if (!is_node_id(id) || bad_label(label)) {
    return 0
  }
  parsed_id = id
  parsed_label = label
  return 1
}

function add_node(id, label, spec) {
  if (id in node_label) {
    if (node_label[id] != label) {
      die("node " id " has two labels")
    }
    return
  }
  node_label[id] = label
  node_spec[id] = spec
  order[++norder] = id
  spec_count[spec]++
}

function parse_chain(line, spec,    rest, p, token, ntok) {
  rest = line
  ntok = 0
  while (rest != "") {
    p = index(rest, " --> ")
    if (p == 0) {
      token = rest
      rest = ""
    } else if (p == 1) {
      die("a diagram line has an empty node")
    } else {
      token = substr(rest, 1, p - 1)
      rest = substr(rest, p + 5)
    }
    if (!parse_node(token)) {
      die("bad node \"" token "\"")
    }
    add_node(parsed_id, parsed_label, spec)
    ntok++
  }
  if (ntok == 0) {
    die("a diagram line has no node")
  }
}

function remember_body(line) {
  body[++nbody] = line
}

BEGIN {
  nbody = 0
  norder = 0
}

{
  all[++na] = strip($0)
}

END {
  fence_ch = ""
  fence_len = 0
  headings = 0
  heading_at = 0
  mermaid_opens = 0
  mermaid_at = 0
  for (i = 1; i <= na; i++) {
    if (fence_len > 0) {
      if (parse_fence(all[i]) && mark_ch == fence_ch && mark_n >= fence_len && mark_rest ~ /^[[:space:]]*$/) {
        fence_ch = ""
        fence_len = 0
      }
      continue
    }
    if (parse_fence(all[i]) && (mark_ch != "`" || index(mark_rest, "`") == 0)) {
      if (mark_rest ~ /^mermaid[[:space:]]*$/) {
        mermaid_opens++
        mermaid_at = i
        if (all[i] != "```mermaid") {
          die("the mermaid fence must be a line ```mermaid")
        }
      }
      fence_ch = mark_ch
      fence_len = mark_n
      continue
    }
    if (all[i] == "## E2E workflow") {
      headings++
      heading_at = i
    }
  }
  if (fence_len > 0) {
    die("a code fence is still open")
  }
  if (headings != 1) {
    die("ALIGN.md needs exactly one ## E2E workflow heading")
  }
  if (mermaid_opens != 1) {
    die("ALIGN.md needs exactly one ```mermaid diagram")
  }

  prev = ""
  for (i = heading_at - 1; i >= 1; i--) {
    if (all[i] ~ /^# /) {
      prev = all[i]
      break
    }
  }
  if (prev != "# End state") {
    die("## E2E workflow must be inside # End state")
  }

  fence_at = 0
  for (i = heading_at + 1; i <= na; i++) {
    if (all[i] ~ /^[[:space:]]*$/) {
      continue
    }
    if (all[i] != "```mermaid") {
      die("## E2E workflow must be followed by the mermaid fence")
    }
    fence_at = i
    break
  }
  if (fence_at == 0 || fence_at != mermaid_at) {
    die("the mermaid fence must follow ## E2E workflow")
  }

  close_at = 0
  for (i = fence_at + 1; i <= na; i++) {
    if (all[i] == "```") {
      close_at = i
      break
    }
    if (parse_fence(all[i]) && mark_ch == "`" && mark_n >= 3 && mark_rest ~ /^[[:space:]]*$/) {
      die("the mermaid fence must close with ```")
    }
  }
  if (close_at == 0) {
    die("the mermaid fence is not closed")
  }

  for (i = close_at + 1; i <= na; i++) {
    if (all[i] ~ /^[[:space:]]*$/ || all[i] ~ /^---[[:space:]]*$/) {
      continue
    }
    if (all[i] ~ /^# /) {
      break
    }
    die("## E2E workflow contains more than the diagram")
  }

  spec = ""
  open = 0
  started = 0
  for (i = fence_at + 1; i < close_at; i++) {
    line = ltrim(all[i])
    if (line == "") {
      remember_body(all[i])
      continue
    }
    if (!started) {
      if (line != "flowchart LR") {
        die("the diagram must start with flowchart LR")
      }
      started = 1
      remember_body(all[i])
      continue
    }
    if (line ~ /^(flowchart|graph)[[:space:]]/) {
      die("the diagram has a second flowchart")
    }
    if (substr(line, 1, 9) == "subgraph ") {
      if (open) {
        die("a journey subgraph is already open")
      }
      rest = substr(line, 10)
      q = index(rest, " [\"")
      if (q < 2) {
        die("bad journey subgraph \"" line "\"")
      }
      file = substr(rest, 1, q - 1)
      if (substr(rest, q) != " [\"" file "\"]" || !is_spec(file)) {
        die("a journey label must be the spec file name in kebab-case")
      }
      if (file in spec_seen) {
        die("journey " file " is repeated")
      }
      spec_seen[file] = 1
      spec = file
      open = 1
      remember_body(all[i])
      continue
    }
    if (line == "end") {
      if (!open) {
        die("end has no journey subgraph")
      }
      if (spec_count[spec] + 0 == 0) {
        die("journey " spec " has no nodes")
      }
      open = 0
      spec = ""
      remember_body(all[i])
      continue
    }
    parse_chain(line, open ? spec : "-")
    remember_body(all[i])
  }
  if (!started) {
    die("the diagram is empty")
  }
  if (open) {
    die("a journey subgraph is not closed")
  }
  if (norder == 0) {
    die("the diagram has no nodes")
  }
  for (name in spec_count) {
    if (spec_count[name] > 7) {
      if (name == "-") {
        die("the diagram has more than 7 nodes outside a journey")
      }
      die("journey " name " has more than 7 nodes")
    }
  }

  if (mode == "extract") {
    m = nbody
    while (m > 0 && body[m] ~ /^[[:space:]]*$/) {
      m--
    }
    for (i = 1; i <= m; i++) {
      print body[i]
    }
    exit 0
  }

  # check: proofs and the files list
  fence_ch = ""
  fence_len = 0
  in_files = 0
  saw_files = 0
  files_n = 0
  for (i = 1; i <= na; i++) {
    if (fence_len > 0) {
      if (parse_fence(all[i]) && mark_ch == fence_ch && mark_n >= fence_len && mark_rest ~ /^[[:space:]]*$/) {
        fence_ch = ""
        fence_len = 0
      }
      continue
    }
    if (parse_fence(all[i]) && (mark_ch != "`" || index(mark_rest, "`") == 0)) {
      fence_ch = mark_ch
      fence_len = mark_n
      continue
    }
    if (all[i] ~ /^# /) {
      in_files = 0
      if (all[i] == "# Files") {
        if (saw_files) {
          die("# Files is repeated")
        }
        saw_files = 1
        in_files = 1
      }
      continue
    }
    if (substr(all[i], 1, 14) == "- Proof: E2E: ") {
      id = substr(all[i], 15)
      if (!is_node_id(id) || !(id in node_label)) {
        die("E2E proof names an unknown node " id)
      }
      if (node_spec[id] == "-") {
        die("E2E proof " id " is not inside a Playwright journey")
      }
    }
    if (substr(all[i], 1, 15) == "- Proof: file `") {
      rest = substr(all[i], 16)
      if (rest == "" || substr(rest, length(rest), 1) != "`" || index(substr(rest, 1, length(rest) - 1), "`") > 0) {
        die("a file proof must be - Proof: file `<path>`")
      }
      path = substr(rest, 1, length(rest) - 1)
      if (path == "") {
        die("a file proof has an empty path")
      }
      proof_files[++nproof] = path
    }
    if (in_files) {
      if (all[i] ~ /^[[:space:]]*$/ || all[i] ~ /^---[[:space:]]*$/) {
        continue
      }
      if (all[i] !~ /^- `[^\`]+` · (NEW|MODIFIED|DELETED) · .+$/) {
        die("a files bullet must be - `<path>` · NEW | MODIFIED | DELETED · <why>")
      }
      rest = substr(all[i], 4)
      q = index(rest, "`")
      path = substr(rest, 1, q - 1)
      if (path in file_set) {
        die("file " path " is listed twice")
      }
      file_set[path] = 1
      files_n++
    }
  }
  if (saw_files && files_n == 0) {
    die("# Files needs one bullet per path")
  }
  if (files_n == 0 && nproof > 0) {
    die("a file proof needs a # Files list")
  }
  for (i = 1; i <= nproof; i++) {
    if (!(proof_files[i] in file_set)) {
      die("file proof " proof_files[i] " is not in # Files")
    }
  }

  for (i = 1; i <= norder; i++) {
    id = order[i]
    printf "%s\t%s\t%s\n", id, node_spec[id], node_label[id]
  }
  exit 0
}
'

run_awk() {
  awk -v mode="$1" "$awk_prog" "$2"
}

if [ "$mode" = "check" ]; then
  if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
    echo "usage: e2e-workflow check <ALIGN.md>" >&2
    exit 1
  fi
  run_awk check "$1"
elif [ "$mode" = "diff" ]; then
  if [ "$#" -ne 2 ] || [ ! -f "$1" ] || [ ! -f "$2" ]; then
    echo "usage: e2e-workflow diff <ALIGN.md> <ALIGN.approved.md>" >&2
    exit 1
  fi
  tmp=$(mktemp "${TMPDIR:-/tmp}/e2e-workflow.XXXXXX")
  tmp2=$(mktemp "${TMPDIR:-/tmp}/e2e-workflow.XXXXXX")
  trap 'rm -f "$tmp" "$tmp2"' EXIT
  if ! run_awk extract "$1" > "$tmp"; then
    echo invalid
    exit 1
  fi
  if ! run_awk extract "$2" > "$tmp2"; then
    echo invalid
    exit 1
  fi
  if cmp -s "$tmp" "$tmp2"; then
    echo match
  else
    echo drift
    exit 1
  fi
else
  echo "usage: e2e-workflow check <ALIGN.md> | diff <ALIGN.md> <ALIGN.approved.md>" >&2
  exit 1
fi
